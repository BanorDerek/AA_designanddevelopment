# Namecheap cPanel MySQL — create the DB and user in cPanel > MySQL Databases first.
# cPanel usually prefixes both the DB name and username with your account name,
# e.g. banopehj_aadesigns and banopehj_aaadmin — copy the exact values it generates.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=youraccount_aadesigns
DB_USER=youraccount_aaadmin
DB_PASSWORD=changeme

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

PORT=5000
NODE_ENV=production

# Public URL where uploaded images are served from, e.g. https://app.aadesigns.com
UPLOADS_BASE_URL=https://yourdomain.com
